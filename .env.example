# Copy to .env and fill in real values. NEVER commit .env.
DB_HOST=localhost
DB_PORT=5433
DB_USER=cadence_user
DB_PASSWORD=changeme
DB_NAME=cadence

# Metabase (local container)
METABASE_PORT=3001

# Simulation controls (see src/simulate/generate_daily_sip_data.py)
SIM_N_USERS=5000
SIM_START_DATE=2025-01-01
SIM_END_DATE=2025-12-31
SIM_RANDOM_SEED=42

# Metabase admin (local instance) — set your own before provisioning
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me-min-8-chars
